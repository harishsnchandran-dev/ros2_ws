<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parker_linear_actuator">

    <!-- ===================================================================
         sim_mode:
           true  → use mock_components/GenericSystem (no real hardware needed)
           false → use real ParkerHardwareInterface over RS232
         Pass at launch: ros2 launch parker_actuator parker_actuator.launch.py sim_mode:=true
         ================================================================= -->
    <xacro:arg name="sim_mode" default="false"/>

    <!-- Materials -->
    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="silver">
        <color rgba="0.75 0.75 0.75 1.0"/>
    </material>
    <material name="parker_blue">
        <color rgba="0.0 0.2 0.5 1.0"/>
    </material>

    <!-- World Link -->
    <link name="world"/>

    <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- Base Link (outer housing / tube) -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <box size="0.1 0.1 0.5"/>
            </geometry>
            <material name="parker_blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <box size="0.1 0.1 0.5"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="5.0"/>
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Slider Link (moving rod) -->
    <link name="slider_link">
        <visual>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.5"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.5"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- Prismatic Joint — 0 to 400 mm stroke -->
    <joint name="slider_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="slider_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="0.0" upper="0.4" effort="1000.0" velocity="0.5"/>
        <dynamics damping="10.0" friction="5.0"/>
    </joint>

    <!-- =====================================================================
         ROS 2 Control — Hardware Interface Selection
         ===================================================================== -->

    <!-- SIMULATION MODE: mock_components mirrors commands → states instantly -->
    <xacro:if value="$(arg sim_mode)">
        <ros2_control name="ParkerHardwareInterface" type="system">
            <hardware>
                <plugin>mock_components/GenericSystem</plugin>
                <param name="fake_sensor_commands">false</param>
                <param name="state_following_offset">0.0</param>
            </hardware>
            <joint name="slider_joint">
                <command_interface name="position">
                    <param name="min">0.0</param>
                    <param name="max">0.4</param>
                </command_interface>
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
        </ros2_control>
    </xacro:if>

    <!-- REAL HARDWARE MODE: Parker Compax3 over RS232 -->
    <xacro:unless value="$(arg sim_mode)">
        <ros2_control name="ParkerHardwareInterface" type="system">
            <hardware>
                <plugin>parker_actuator/ParkerHardwareInterface</plugin>
                <param name="serial_port">/dev/ttyUSB0</param>
                <param name="baud_rate">115200</param>
            </hardware>
            <joint name="slider_joint">
                <command_interface name="position">
                    <param name="min">0.0</param>
                    <param name="max">0.4</param>
                </command_interface>
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
        </ros2_control>
    </xacro:unless>

</robot>
